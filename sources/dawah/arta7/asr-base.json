  "segments": [
    {
      "text": "سعيد مهدئ نفسي دلتسع وتسعين طريق للسعادة",
      "start": 0.0,
      "end": 3.66
    },
    {
      "text": "دلتسع وتسعين طريق للجنة",
      "start": 3.66,
      "end": 5.96
    },
    {
      "text": "داعو مرضاكم بها الاسماء الحصنة من احصاه دخل الجنة",
      "start": 5.96,
      "end": 11.84
    },
    {
      "text": "جنة تدونيها باللأخرى يبانت لازم تعرف",
      "start": 11.84,
      "end": 14.62
    },
    {
      "text": "ايسي ترتاح",
      "start": 14.62,
      "end": 16.54
    },
    {
      "text": "هترتاح لما تعرف ربنا سبحرة تعالى",
      "start": 16.54,
      "end": 19.02
    },
    {
      "text": "فوحاً يقول لك تبوه فتحر ابن بتأخر ليه",
      "start": 19.02,
      "end": 22.14
    },
    {
      "text": "فتحر ابن بتأخر عشان يختبر اصرارك",
      "start": 22.14,
      "end": 24.46
    },
    {
      "text": "عشان يختبر اصرارك تخال ان تفلبيت",
      "start": 24.46,
      "end": 27.2
    },
    {
      "text": "ومعكمسان والديتك",
      "start": 27.2,
      "end": 28.52
    },
    {
      "text": "ومعك حد حبي بك او فق اغم علي وأمن طوله",
      "start": 28.52,
      "end": 31.66
    },
    {
      "text": "ها لس حد بيقول لن بارح",
      "start": 31.66,
      "end": 33.56
    },
    {
      "text": "يعني حد بي من اخوان زكت فق اغم عليها",
      "start": 33.56,
      "end": 36.62
    },
    {
      "text": "فبيقول لي بيطصل ووبي عيات الحوني",
      "start": 36.62,
      "end": 40.46
    },
    {
      "text": "تبقوا في الدائل ان تبتطصل بالدكتور اللي تبتطصل",
      "start": 40.46,
      "end": 43.38
    },
    {
      "text": "بسعيدها مرضا شعليك",
      "start": 43.38,
      "end": 44.88
    },
    {
      "text": "هتوليها خصارة دكتور مرضا الشيار آجة",
      "start": 44.88,
      "end": 47.92
    },
    {
      "text": "دا تبتطصل متمره",
      "start": 47.92,
      "end": 49.44
    },
    {
      "text": "دا تبتطصل متن مرة",
      "start": 49.44,
      "end": 51.22
    },
    {
      "text": "اللي بيقول لي بيقول لي فضل يبتطصل يبتصل",
      "start": 51.22,
      "end": 54.64
    },
    {
      "text": "ما ومفيشك",
      "start": 54.64,
      "end": 55.82
    },
    {
      "text": "ومفيشك الامدة",
      "start": 55.82,
      "end": 56.44
    },
    {
      "text": "سعست تصبح لازم يرود يعني لازم يرود",
      "start": 56.44,
      "end": 59.24
    },
    {
      "text": "اخو بالصبت كده لو انت خبطة على مبب فرج الله",
      "start": 59.24,
      "end": 62.34
    },
    {
      "text": "ومتفتح لك شي تمشي",
      "start": 62.34,
      "end": 64.32
    },
    {
      "text": "يبن انت منك شي غير وأسلا",
      "start": 64.32,
      "end": 65.82
    },
    {
      "text": "خبطة فرمبنا بيختبر اصرارك",
      "start": 65.82,
      "end": 68.3
    },
    {
      "text": "رمبنا بيختبر يا قيمك إنه هو الحل الوحيد",
      "start": 68.59,
      "end": 71.76
    },
    {
      "text": "رمبنا بيختبر ثقة تكفي",
      "start": 72.61,
      "end": 74.7
    },
    {
      "text": "رمبنا بيختبر دا انت ممكن تروحها دكتور يقول لك الحكزة بعد شهر",
      "start": 75.48,
      "end": 79.38
    },
    {
      "text": "تفضل وقف على مبب و شهر كامل",
      "start": 79.38,
      "end": 81.3
    },
    {
      "text": "انت تفضل وقف على مبب و Lubنة دي",
      "start": 81.3,
      "end": 83.34
    },
    {
      "text": "مستعدة تفضل وقف على مبب دي",
      "start": 83.34,
      "end": 86.26
    },
    {
      "text": "اوعه لحظة متزهته و تمشي كون المبهي تفتح",
      "start": 86.26,
      "end": 89.9
    },
    {
      "text": "اوعي يبخط الله يسمور على مبب وبنة",
      "start": 89.9,
      "end": 92.9
    },
    {
      "text": "يبخط الله يفضل وقف وصاربير على مبب وبنة",
      "start": 92.9,
      "end": 97.38
    },
    {
      "text": "سبحانه وتعالى",
      "start": 97.38,
      "end": 98.66
    },
    {
      "text": "عشي كنا متولش الفتح بتأخر لي",
      "start": 98.66,
      "end": 101.06
    },
    {
      "text": "هو اللي انت في ده نفسه فاتح",
      "start": 101.06,
      "end": 103.04
    },
    {
      "text": "لما ترفعي لك تعمد ربنا دفتح",
      "start": 103.04,
      "end": 105.84
    },
    {
      "text": "دفتح من الله سبحانه تعالى",
      "start": 105.84,
      "end": 108.0
    },
    {
      "text": "ربنا بحب ده من نك",
      "start": 108.0,
      "end": 109.68
    },
    {
      "text": "فلا تستعجن فاتح الله",
      "start": 109.68,
      "end": 111.98
    },
    {
      "text": "فهو قادم ونقادم من الله سبحانه تعالى",
      "start": 111.98,
      "end": 115.9
    },
    {
      "text": "اسم الله الرزاق",
      "start": 115.9,
      "end": 117.52
    }
  ]
}