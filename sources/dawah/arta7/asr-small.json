  "segments": [
    {
      "text": "مهديق نفسي. دل تسعة و تسعين طريق للسعادة. دل تسعة و تسعين",
      "start": 0.0,
      "end": 4.8
    },
    {
      "text": "طريق للجنة. دا و مرضاكم بالاسماء الحصنة من احصاها دخل",
      "start": 4.8,
      "end": 11.34
    },
    {
      "text": "الجنة جنة الدنيا بل الاخرى. يبقى انت لازم تعرف. ايسي ترتاح?",
      "start": 11.34,
      "end": 16.52
    },
    {
      "text": "هترتاح لما تعرف ربنا سبحانه وتعالى فهو حين يقولك طب هو",
      "start": 16.78,
      "end": 20.36
    },
    {
      "text": "فتح ربنا بيتأخر ليه. فتح ربنا بيتأخر عشان يختبر",
      "start": 20.36,
      "end": 23.78
    },
    {
      "text": "اسرارك. عشان يختبر اسرارك. تخال انت في البيت. ومعك",
      "start": 23.78,
      "end": 27.7
    },
    {
      "text": "مثلا ولدتك. ولا معك حد حبيبك او فق اغم عليه وقى من طوله. ها لسه",
      "start": 27.7,
      "end": 32.42
    },
    {
      "text": "حد يقول لي بارح. يعني حد من اخوانها زبت فق اغم عليها. فبيقول لي",
      "start": 32.42,
      "end": 37.28
    },
    {
      "text": "بيتصل. وقى بعيط. الحقوني. اخ. طب افرد دقل انت بتتصل",
      "start": 37.28,
      "end": 42.38
    },
    {
      "text": "بالدكتور اللي بتتصل بيساعتها بردش عليك. هتقول يا",
      "start": 42.38,
      "end": 45.62
    },
    {
      "text": "خسارة. الدكتور مردش يا راجع. دانت تتصل مت مرة. دانت تتصل",
      "start": 45.62,
      "end": 50.46
    },
    {
      "text": "متين مرة. اللي بيكلمني بيقول لي فضل يتصل يتصل. ما",
      "start": 50.46,
      "end": 55.1
    },
    {
      "text": "وما فيش يكلمني با. احسع ستة صبح لازم يرد يعني لازم يرد.",
      "start": 55.1,
      "end": 59.26
    },
    {
      "text": "اخو بالضبط كده لو انت خبطت على باب فرجي الله وما تفتح لكش",
      "start": 59.52,
      "end": 63.72
    },
    {
      "text": "تمشي. يا ابن انت ملكش غيره اصلا. خبط. فربنا بيختبر اصرارك.",
      "start": 63.72,
      "end": 68.28
    },
    {
      "text": "ربنا بيختبر ياقيمك انه هو الحل الوحيد. ربنا بيختبر ثقة",
      "start": 68.54,
      "end": 74.2
    },
    {
      "text": "تكفيه. ربنا بيختبر دانت ممكن تروح لدكتور يقول لك الحقز",
      "start": 74.2,
      "end": 78.72
    },
    {
      "text": "بعد شهر. تفضل وقف على بابه شهر كامل. انت تفضل وقف على",
      "start": 78.72,
      "end": 82.46
    },
    {
      "text": "باب ربنا دي. مستعدة تفضل وقف على بابه دي. اوعة. لحظة",
      "start": 82.46,
      "end": 87.86
    },
    {
      "text": "متزه وتمشي يكون البابه يتفتح. اوعة. يا باخت الله يصبر على",
      "start": 87.86,
      "end": 92.2
    },
    {
      "text": "باب ربنا. يا باخت الله يفضل وقف وصبر على باب ربنا سبحانه",
      "start": 92.2,
      "end": 98.02
    },
    {
      "text": "وتعالى. عشان كنا ما تقولش الفتح بتأخر ليه هو هو اللي انت",
      "start": 98.02,
      "end": 102.06
    },
    {
      "text": "فيدا نفسه فتح. لما ترفع اينك وتعبض ربنا ده فتح. ده",
      "start": 102.06,
      "end": 106.42
    },
    {
      "text": "فتح من الله سبحانه وتعالى ربنا بيحب ده منك. فلا تستعج",
      "start": 106.42,
      "end": 111.24
    },
    {
      "text": "فتح الله فهو قادم من قادم من الله سبحانه وتعالى اسم الله",
      "start": 111.24,
      "end": 116.72
    },
    {
      "text": "الرزاق من",
      "start": 116.72,
      "end": 117.94
    }
  ]
}